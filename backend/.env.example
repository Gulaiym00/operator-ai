# set to "production" on Render/etc — enables secure cross-site cookies
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=operator-ai
DB_USER=postgres
DB_PASSWORD=
# true when DB_HOST is a managed provider (Supabase, Neon, ...) that requires SSL
DB_SSL=false
# optional: a single connection string (e.g. Supabase's "Connect" dialog)
# overrides all DB_* fields above when set
# DATABASE_URL=postgresql://user:password@host:port/dbname

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google-callback

GEMINI_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
